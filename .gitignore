# --- Cloned repositories (each versioned independently) ---
# `inatrace repos sync` clones the repos into repos/; only the list is versioned.
/repos/*
!/repos/repos.txt

# --- Scratch files: notes, dumps, anything not to commit ---
/tmp/

# --- Your settings (see .env.example) ---
/.env

# --- Deploy instances: settings and secrets of your servers (`inatrace deploy init`) ---
/deploy/instances/

# --- Generated on the host by `.devcontainer/initialize.py` ---
/.devcontainer/.env
/.devcontainer/.state/

# --- OS ---
.DS_Store
Thumbs.db

# --- Editors / IDE ---
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/extensions.json

# --- Python ---
__pycache__/
.venv/
.pytest_cache/
.ruff_cache/
