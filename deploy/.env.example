# The settings of one INATrace server: `inatrace deploy init <name>` asks for them and
# writes deploy/instances/<name>/.env; `inatrace deploy up <name>` copies it to the
# server, next to compose.yaml. By hand: copy deploy/server/ to the server, put this
# file there as .env, fill it in, and run `docker compose up -d`. See docs/deploy.md.
#
# Lines starting with # keep their default.

# --- Where: read by the CLI only ---------------------------------------------------
# The server, as you reach it with ssh: user@host, or a Host from ~/.ssh/config, where a
# port, key or jump host goes (passed to ssh as is). The user must be able to run docker.
# The files go to ~/inatrace there.
INATRACE_SSH=

# --- What runs: your choice, nothing picks a version for you -------------------------
#INATRACE_BACKEND_IMAGE=ghcr.io/agstack/inatrace-backend
INATRACE_BACKEND_VERSION=
#INATRACE_FRONTEND_IMAGE=ghcr.io/agstack/inatrace-frontend
INATRACE_FRONTEND_VERSION=
# PROD, TEST or DEMO: shown by the frontend; DEMO also changes some backend behavior.
#INATRACE_ENVIRONMENT=PROD

# --- The address --------------------------------------------------------------------
# The domain people open (DNS pointing at the server or at your CDN), or the server's
# public IP address when there is no domain.
INATRACE_SITE=
# The certificate: acme (Let's Encrypt, for a domain; ports 80 and 443 open to the
# internet), internal (Caddy's own, self-signed: for an IP address), or acme-staging
# (Let's Encrypt's staging, for tests that obtain certificates again and again: far higher
# limits than acme's 5 alike a week, but not trusted by browsers).
#INATRACE_TLS=acme
# What sits in front of the server, which says who the client is:
#   direct  nothing: DNS points at the server
#   cdn     a CDN (Cloudflare, CloudFront...): INATRACE_CDN_IP_HEADER names the client
#   lb      a load balancer on the cloud's private network: X-Forwarded-For, read from
#           the right
#INATRACE_FRONT=direct
# cdn only: the CDN's header with the client's address, e.g. CF-Connecting-IP
# (Cloudflare), CloudFront-Viewer-Address (CloudFront), Fastly-Client-IP (Fastly),
# True-Client-IP (Akamai).
#INATRACE_CDN_IP_HEADER=
# Optional, any mode: when set, only requests with the header X-Origin-Secret: <this>
# get through (403 otherwise). Have the CDN add it, so nobody reaches the server
# around it, nor forges the client's address. Letters and digits only.
#INATRACE_ORIGIN_SECRET=
# on: the API description (/v3/api-docs) and Swagger UI (/swagger-ui.html) are open.
#INATRACE_SWAGGER=off

# --- E-mail (registration, password reset) ------------------------------------------
# Without it (false), nothing is sent: an admin activates new users.
#INATRACE_MAIL_ENABLED=false
#INATRACE_MAIL_HOST=
#INATRACE_MAIL_PORT=587
#INATRACE_MAIL_USERNAME=
#INATRACE_MAIL_PASSWORD=
# The sender address of the e-mails.
#INATRACE_MAIL_FROM=
# false when the server takes no username/password.
#INATRACE_MAIL_AUTH=true
# Port 587 uses STARTTLS; port 465, SSL (INATRACE_MAIL_STARTTLS=false, _SSL=true).
#INATRACE_MAIL_STARTTLS=true
#INATRACE_MAIL_SSL=false

# --- Maps (optional) ----------------------------------------------------------------
# The plot map does not draw without a Mapbox token.
#INATRACE_MAPBOX_ACCESS_TOKEN=
#INATRACE_GOOGLE_MAPS_API_KEY=

# --- Secrets: random, made by `deploy init` ------------------------------------------
# The database ones are read only when the database is created: changing them later
# breaks the backend's access. Keep a copy of this file somewhere safe.
INATRACE_DB_PASSWORD=
INATRACE_DB_ROOT_PASSWORD=
INATRACE_JWT_KEY=

# --- Monitoring -----------------------------------------------------------------------
# on: Beszel, a dashboard of the server and its containers (CPU, memory, disk, network,
# history; about 20 MB), only on the server's 127.0.0.1: `inatrace deploy dashboard`
# opens it through ssh. Its agent reads Docker's socket, as good as root on the server.
#INATRACE_MONITORING=off
# Generated by `init`: the dashboard's one user, logged in automatically.
INATRACE_MONITORING_PASSWORD=
# Learned from the server by `up`: the dashboard's key (public) for its agent, and the
# server's docker group, which lets the agent read Docker.
#INATRACE_MONITORING_KEY=
#INATRACE_DOCKER_GID=
# Set by `up` from INATRACE_MONITORING: the optional parts Compose runs (by hand too).
COMPOSE_PROFILES=

# --- Backups ------------------------------------------------------------------------
# How many days backups stay in ~/inatrace/backups: each new one removes those older.
#INATRACE_BACKUP_DAYS=7
# When a backup runs on its own: a cron expression (5 fields, or @daily, @weekly...) in
# the server's time zone, which `up` puts in the user's crontab there; off: never.
# @daily is at midnight; 0 3 * * * at 3 in the morning.
#INATRACE_BACKUP_SCHEDULE=@daily
