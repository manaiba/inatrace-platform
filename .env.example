# Your settings, for the dev container and the dev stack. Copy to .env
# (git-ignored) and edit:
#
#   cp .env.example .env && chmod 600 .env
#
# This file is the only source: variables exported in your shell are ignored.
# Not to be confused with .devcontainer/.env, which `.devcontainer/initialize.py`
# generates from it.

# === Dev container ============================================================
# Read on the host on every `devcontainer up`; a change to these recreates the
# container (volumes are kept).

# --- Instance -----------------------------------------------------------------
# Names the Compose project and its volumes (<instance>-home, <instance>-docker).
# Give a second checkout its own, and other ports, to run it beside this one.
#INATRACE_INSTANCE=inatrace-platform

# --- Ports published on the host (docs/dev-container.md → Ports) --------------
# 127.0.0.1 keeps them off the network; 0.0.0.0 exposes them, e.g. to test from
# a phone on the LAN.
#INATRACE_BIND_ADDRESS=127.0.0.1
#INATRACE_GATEWAY_PORT=8000
#INATRACE_BACKEND_PORT=9000
#INATRACE_FRONTEND_PORT=9080

# --- Playwright (docs/configuration.md → Dev container) -----------------------
# Headed when the host has a Wayland session, headless otherwise. Force it:
#PLAYWRIGHT_HEADLESS=true

# === Dev stack ================================================================
# Read by `inatrace stack up` (docs/dev-stack.md).

# What runs from an image instead of your checkout: fullstack-dev (nothing, the
# default), back-dev (the frontend), front-dev (the backend) or images (both).
#INATRACE_MODE=fullstack-dev

# The images, and their tags. Defaults: agstack's, latest. Pin a release
# (2.40.3) to stay on it, or point at a fork's packages.
#INATRACE_BACKEND_IMAGE=ghcr.io/agstack/inatrace-backend
#INATRACE_BACKEND_VERSION=latest
#INATRACE_FRONTEND_IMAGE=ghcr.io/agstack/inatrace-frontend
#INATRACE_FRONTEND_VERSION=latest

# === GitHub ===================================================================
# The token is read by .devcontainer/provision.py, the forks by `inatrace repos sync`.

# --- Token --------------------------------------------------------------------
# Optional: for `gh` and pushing over HTTPS. Never exported as an environment
# variable.
#INATRACE_GH_TOKEN=github_pat_xxx

# --- Forks (docs/configuration.md → Forks) ------------------------------------
# Per repo in repos/repos.txt: INATRACE_FORK_<REPO>=<owner>/<name> on GitHub, where
# <REPO> is the repo's directory upper-cased, "-" (and any other symbol) as "_".
# The fork becomes `origin` and the repos.txt URL `upstream` (push disabled).
# Repos without a line keep the upstream as `origin`.
#INATRACE_FORK_INATRACE_BACKEND=your-org/inatrace-backend
#INATRACE_FORK_INATRACE_FRONTEND=your-org/inatrace-frontend
#INATRACE_FORK_INATRACE_MOBILE=your-org/inatrace-mobile
#INATRACE_FORK_INATRACE=your-org/inatrace
