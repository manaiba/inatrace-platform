# Your settings for this dev container. Copy to .env (git-ignored) and edit:
#
#   cp .env.example .env && chmod 600 .env
#
# Read by .devcontainer/initialize.sh on every `devcontainer up`; a change that
# affects the container (ports, address) recreates it. This file is the only
# source: variables exported in your shell are ignored. Not to be confused with
# .devcontainer/.env, which initialize.sh generates.

# --- Ports published on the host (README → Ports) -----------------------------
# 127.0.0.1 keeps them off the network; 0.0.0.0 exposes them, e.g. to test from
# a phone on the LAN.
#INATRACE_BIND_ADDRESS=127.0.0.1
#INATRACE_GATEWAY_PORT=8000
#INATRACE_BACKEND_PORT=9000
#INATRACE_FRONTEND_PORT=9080

# --- GitHub token (README → Credentials) --------------------------------------
# Optional: for `gh` and pushing over HTTPS. Reaches the container as the file
# /run/secrets/gh_token, never as an environment variable.
#INATRACE_GH_TOKEN=github_pat_xxx

# --- Forks (README → Credentials) ---------------------------------------------
# Per repo in src/repos.txt: INATRACE_FORK_<REPO>=<owner>/<name> on GitHub, where
# <REPO> is the repo's directory upper-cased, "-" (and any other symbol) as "_".
# setup.sh makes the fork `origin` and the repos.txt URL `upstream` (push
# disabled). Repos without a line keep the upstream as `origin`.
#INATRACE_FORK_INATRACE_BACKEND=your-org/inatrace-backend
#INATRACE_FORK_INATRACE_FRONTEND=your-org/inatrace-frontend
#INATRACE_FORK_INATRACE_MOBILE=your-org/inatrace-mobile
#INATRACE_FORK_INATRACE=your-org/inatrace

# --- Playwright (README → Desktop bridges) -------------------------------------
# Headed when the host has a Wayland session, headless otherwise. Force it:
#PLAYWRIGHT_HEADLESS=true
