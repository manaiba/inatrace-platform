# The look every terminal clip shares (Source'd by the others): black, the CLI's own colors. The
# clip is the frame below the caption band; make.py puts it there (LAYOUT in make.py).
Set Shell bash
Set FontFamily "JetBrains Mono"
Set FontSize 18
Set LetterSpacing 0
Set LineHeight 1.25
Set Width 1920
Set Height 970
Set Padding 24
Set Margin 20
Set MarginFill "out/bg-clip.png"
Set BorderRadius 12
Set Theme { "name": "inatrace", "background": "#0a0c0a", "foreground": "#d4d7d4", "cursor": "#5fd787", "selection": "#2a3a2e", "black": "#1c1f1c", "red": "#ff6b6b", "green": "#5fd787", "yellow": "#ffd166", "blue": "#6cb6ff", "magenta": "#d692ff", "cyan": "#5fd7ff", "white": "#d4d7d4", "brightBlack": "#6b726b", "brightRed": "#ff8f8f", "brightGreen": "#87f5a8", "brightYellow": "#ffe08a", "brightBlue": "#99ccff", "brightMagenta": "#e5b3ff", "brightCyan": "#9be7ff", "brightWhite": "#ffffff" }
Set TypingSpeed 60ms
Set CursorBlink false
Set Framerate 30
